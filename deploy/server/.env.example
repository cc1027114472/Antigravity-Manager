# Required: API authentication key used by the proxy API.
API_KEY=replace-with-a-long-random-api-key

# Recommended: separate password for the Web management UI.
WEB_PASSWORD=replace-with-a-separate-management-password

LOG_LEVEL=info
ABV_MAX_BODY_SIZE=104857600

# Set this when OAuth callbacks need a public HTTPS URL.
# ABV_PUBLIC_URL=https://example.com

# Optional Docker registry mirror selection: auto, true, or false.
USE_MIRROR=auto
